# Copy to .env and fill in your API credentials.
GODARK_API_KEY_ID=
GODARK_API_SECRET=
GODARK_PASSPHRASE=

# Sequencer HPKE static public key (64 hex chars). Required for encrypted
# trading. Not baked into the crate.
# GDX_HPKE_STATIC_PUBLIC_KEY=

# Optional URL overrides (otherwise use .environment(...)):
# Testnet edge/REST: wss://api.godark-dex.com / https://api.godark-dex.com
# Devnet edge/REST:  ws://18.143.165.149:13300 / http://18.143.165.149:13300
# Localnet (`gdx up`): ws://127.0.0.1:13300 / http://127.0.0.1:13300
# GODARK_EDGE_URL=
# GODARK_REST_URL=

# --- local `gdx up` stack (static key, no passphrase) ---
# GODARK_EDGE_URL=ws://127.0.0.1:13300
# GODARK_REST_URL=http://127.0.0.1:13300
# GODARK_API_KEY=test-key-1
# GDX_HPKE_STATIC_PUBLIC_KEY=<copy VITE_GDX_HPKE_STATIC_PUBKEY from gdx-web/.env.localnet>

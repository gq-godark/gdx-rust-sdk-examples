# Copy to .env and fill in your API credentials.
GODARK_API_KEY_ID=
GODARK_API_SECRET=
GODARK_PASSPHRASE=

# Noise XK pin (64 hex chars). Optional on testnet/devnet —
# Environment::Testnet and Environment::Devnet each bake in a distinct
# public sequencer pin (do not share one key across both).
# Override for localnet / custom pins:
# GDX_NOISE_STATIC_PUBLIC_KEY=
# Aliases: GDX_NOISE_STATIC_PUBKEY, GODARK_NOISE_STATIC_PUBLIC_KEY

# Optional URL overrides (otherwise use .environment(...)):
# Testnet edge/REST: wss://api.godark-dex.com / https://api.godark-dex.com
# Devnet edge/REST:  ws://18.143.165.149:13300 / http://18.143.165.149:13300
# Localnet edge:     ws://127.0.0.1:4000
# GODARK_EDGE_URL=
# GODARK_REST_URL=


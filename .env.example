# GoDark SDK credentials
# Copy this file to .env and fill in your API credentials.
# Create a key at https://app.godark-dex.com → Settings → API Key Management
GODARK_API_KEY_ID=
GODARK_API_SECRET=
# Single-quote if the passphrase contains $ (dotenvy interpolates unquoted $VAR).
# Example: GODARK_PASSPHRASE='GoQuant1$'
GODARK_PASSPHRASE=

# Optional overrides. Defaults target public testnet via the SDK Environment
# preset (baked-in edge URL + Noise pin). Leave these unset for normal testnet use.
# GODARK_EDGE_URL=wss://api.godark-dex.com
# GDX_NOISE_STATIC_PUBLIC_KEY=
# Aliases: GDX_NOISE_STATIC_PUBKEY, GODARK_NOISE_STATIC_PUBLIC_KEY

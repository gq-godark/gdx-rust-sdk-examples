# GoDark SDK credentials
# Copy this file to .env and fill in your API credentials.

# --- Hosted / testnet (API key pair) ---
GODARK_API_KEY_ID=
GODARK_API_SECRET=
GODARK_PASSPHRASE=
# GODARK_EDGE_URL=wss://api.godark-dex.com

# --- Localnet (gdx-cli `gdx up`; legacy API key) ---
# GODARK_EDGE_URL=ws://127.0.0.1:13300
# GODARK_API_KEY=test-key-1
# GODARK_USER_UUID=00000000-0000-4000-8000-000000000001

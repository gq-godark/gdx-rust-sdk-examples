# Godark Rust examples -- environment
#
# Copy this file to `.env` (it is git-ignored) and fill in the values you
# need. Each example program calls `dotenvy::dotenv()` on startup, which
# walks up from the working directory looking for a `.env` file and merges
# its `KEY=VALUE` pairs into the process environment. Existing OS
# environment variables always win, so `KEY=value cargo run --example X`
# still overrides whatever is here.

# ---------------------------------------------------------------------------
# Credentials (used by every WebSocket + REST trading example)
# ---------------------------------------------------------------------------

GODARK_API_KEY_ID=gdk_...
GODARK_API_SECRET=...

# Bare static token (e.g. localnet edges with a fixed key list). When set,
# overrides GODARK_API_KEY_ID + GODARK_API_SECRET.
# GODARK_API_KEY=test-key-1

# Legacy GDX_* aliases are also honored as a fallback (rarely needed).
# GDX_API_KEY_ID=gdk_...
# GDX_API_SECRET=...
# GDX_API_KEY=test-key-1

# ---------------------------------------------------------------------------
# WebSocket trading + market data (quickstart, e2e_trading_smoke,
# full_trader_example, market_data_example)
# ---------------------------------------------------------------------------

# WebSocket endpoint. Defaults to wss://api.godark-dex.com (testnet).
GODARK_EDGE_URL=ws://localhost:4000
# GDX_EDGE_URL is accepted as an alias.

# Resting limit price used by quickstart / e2e_trading_smoke / full_trader_*.
# Override on environments that cap mark deviation (e.g. localnet at 1000
# bps). Pick something within ~10% of the current mark — full_trader_example
# treats this as the BUY base and derives modify (= +500) and SELL (= +2000).
GODARK_TEST_LIMIT_PRICE=85000

# Dev-only: accept self-signed certificates for the market data + WS clients.
# GODARK_TLS_SKIP_VERIFY=1
# GDX_TLS_SKIP_VERIFY=1

# ---------------------------------------------------------------------------
# REST (full_trader_rest)
# ---------------------------------------------------------------------------
#
# By default the REST example reuses GODARK_API_KEY_ID + GODARK_API_SECRET
# above and derives the REST base URL from GODARK_EDGE_URL by swapping
# ws[s]://  ->  http[s]:// (the localnet edge serves both protocols on the
# same listener). Override either explicitly when REST and WebSocket live
# on different hosts:
#
# GODARK_REST_URL=http://localhost:4000
# GDX_REST_URL=http://localhost:4000     # legacy alias, also honored
